# Client X — environment variable template.
#
# Copy to .env.local for local development (never commit real values).
# Platform credentials (OAuth client secrets, bot tokens, API keys)
# are SERVER-SIDE ONLY: they are read by route handlers in app/api and
# by lib/server/*, never by client components, and never serialised
# into any client-facing JSON response. Do NOT prefix secrets with
# NEXT_PUBLIC_ — that would expose them in the browser bundle.

# Postgres connection string for the production database swap behind
# lib/server/db.ts (schema: prisma/schema.prisma). Leave blank to run
# on the in-memory repository fallback.
DATABASE_URL=

# Auth session signing secret (generate a long random value in
# production and keep it in the deployment platform's secret store).
AUTH_SECRET=
NEXTAUTH_SECRET=

# Public base URL of this deployment (used by the auth flow).
NEXTAUTH_URL=http://localhost:3000

# Google OAuth app (configured in Google Cloud Console; server-side
# only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth app (configured in LinkedIn Developer Portal;
# server-side only).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
